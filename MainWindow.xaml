<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Pulse"
        Title="Pulse" Width="1060" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgSolid}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <p:BoolConv x:Key="B"/>

        <DataTemplate x:Key="AdapterCard" DataType="{x:Type p:AdapterVM}">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" Background="#14FFFFFF">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text2}" FontSize="12"/>
                            <TextBlock Text="{Binding RatesText}" Foreground="{StaticResource Text3}" FontSize="12"
                                       Visibility="{Binding ShowRates, Converter={StaticResource B}}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Style="{StaticResource IconToggle}" IsChecked="{Binding SettingsOpen}"
                                      ToolTip="Settings for this connection"/>
                        <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" Margin="6,0,0,0"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" IsHitTestVisible="{Binding Idle}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding SettingsOpen, Converter={StaticResource B}}">
                        <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text3}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                        <CheckBox Content="Turn off with “Go offline”" IsChecked="{Binding InGameMode}"/>
                        <CheckBox Margin="0,8,0,0" Content="Fully disable the adapter (slower)" IsChecked="{Binding FullyDisable}"
                                  Visibility="{Binding IsWiFi, Converter={StaticResource B}}"
                                  ToolTip="Off: only the Wi-Fi radio is switched (instant). On: the whole network device is disabled."/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource B}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppRow" DataType="{x:Type p:AppUsageVM}">
            <Grid Height="38" Margin="0,1" Opacity="{Binding Dim}">
                <Rectangle Fill="{StaticResource Accent}" Opacity="0.13" RadiusX="6" RadiusY="6"
                           HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleX="{Binding Share}"/></Rectangle.RenderTransform>
                </Rectangle>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="84"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding DownText}" Foreground="{StaticResource DownBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding UpText}" Foreground="{StaticResource UpBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (32px, same height as the native caption buttons) -->
        <Grid Grid.Row="0" Height="32" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Pulse" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Not-admin bar -->
        <Border Grid.Row="1" Margin="16,0,16,12" Padding="14,10" CornerRadius="8" Background="#22FFC857"
                Visibility="{Binding NotAdmin, Converter={StaticResource B}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Restart as admin" Click="RestartAdmin_Click"/>
                <TextBlock Text="Running without admin rights: Ethernet control and per-app usage are unavailable."
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Hero -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="16,0,16,12" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,3,12,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource UpBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusTitle}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusSub}" Foreground="{StaticResource Text2}" Margin="24,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Height="52" MinWidth="210" Command="{Binding ToggleGameModeCommand}"
                        IsEnabled="{Binding MasterBusy, Converter={StaticResource B}, ConverterParameter=invert}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnyOn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#141414" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GameButtonText}" FontSize="16" FontWeight="SemiBold" Foreground="#141414"/>
                            <TextBlock Text="Ctrl + Alt + N" FontSize="11" Foreground="#99141414"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connections -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Connections" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource AdapterCard}"/>
                        <ToggleButton IsChecked="{Binding ShowVirtual}" Visibility="{Binding HasVirtual, Converter={StaticResource B}}"
                                      Cursor="Hand" Focusable="False" Margin="0,2,0,8" HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <TextBlock x:Name="Chev" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VirtualLabel}" Foreground="{StaticResource Text3}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="Text" Value="&#xE70D;"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ItemsControl ItemsSource="{Binding VirtualAdapters}" ItemTemplate="{StaticResource AdapterCard}"
                                      Visibility="{Binding ShowVirtual, Converter={StaticResource B}}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Traffic + apps -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}" Padding="20,16,20,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DownBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Download" Foreground="{StaticResource Text2}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DownText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource DownBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource UpBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Upload" Foreground="{StaticResource Text2}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UpText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <Border HorizontalAlignment="Right" Background="#14FFFFFF" CornerRadius="7" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="u" Content="MB/s" IsChecked="{Binding UseBytes, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="u" Content="Mbps" IsChecked="{Binding UseBits, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource Text3}" FontSize="12"
                                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <p:GraphControl x:Name="Graph" Height="130" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16,14,16,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Reset" Command="{Binding ResetAppsCommand}"/>
                            <TextBlock Text="Apps" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="  live use since Pulse started" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14,0,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="104"/><ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Margin="-4,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SortByCommand}" CommandParameter="Name">
                                <TextBlock FontSize="11.5"><Run Text="Name"/><Run Text="{Binding NameMark, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Margin="0,0,-4,0" HorizontalAlignment="Right"
                                    Command="{Binding SortByCommand}" CommandParameter="Download">
                                <TextBlock FontSize="11.5"><Run Text="Download"/><Run Text="{Binding DownMark, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Margin="0,0,-4,0" HorizontalAlignment="Right"
                                    Command="{Binding SortByCommand}" CommandParameter="Upload">
                                <TextBlock FontSize="11.5"><Run Text="Upload"/><Run Text="{Binding UpMark, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Margin="0,0,-4,0" HorizontalAlignment="Right"
                                    Command="{Binding SortByCommand}" CommandParameter="Total">
                                <TextBlock FontSize="11.5"><Run Text="Total"/><Run Text="{Binding TotalMark, Mode=OneWay}"/></TextBlock>
                            </Button>
                        </Grid>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AppsView}" ItemTemplate="{StaticResource AppRow}"/>
                            </ScrollViewer>
                            <TextBlock Text="{Binding AppsEmptyText}" Foreground="{StaticResource Text3}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding ShowAppsEmpty, Converter={StaticResource B}}"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
